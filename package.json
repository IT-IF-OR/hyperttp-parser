{
  "name": "@hyperttp/parser",
  "version": "3.0.3",
  "description": "Automated response parsing and content conversion plugin for Hyperttp client",
  "keywords": [
    "hyperttp"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-parser.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "build": "node ../../scripts/build-package.ts",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "node-html-parser": "^9.0.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.3",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "node-html-parser": "^9.0.6"
  },
  "peerDependenciesMeta": {
    "node-html-parser": {
      "optional": true
    },
    "fast-xml-builder": {
      "optional": true
    },
    "fast-xml-parser": {
      "optional": true
    }
  }
}
